{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/producto/hershey-s-c4-whey-protein-2-lb",
      "destination": "/producto/cellucor-c4-whey-protein-2-lb",
      "permanent": true
    },
    {
      "source": "/producto/reese-s-c4-whey-protein-5-8-lb",
      "destination": "/producto/cellucor-c4-whey-protein-5-8-lb",
      "permanent": true
    },
    {
      "source": "/producto/nutrex-producto-sin-nombre-60-servidas",
      "destination": "/producto/nutrex-creatine-monohydrate-60-servidas",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*).(js|mjs|css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
